# ─── Gateway ────────────────────────────────────────────────────────
# Listen address (default: :8080)
LISTEN_ADDR=:8080

# Auth token for API endpoints (CHANGE THIS!)
GATEWAY_TOKEN=sk-merged-change-me

# Dashboard auth token (empty = localhost only; set for remote access)
# DASHBOARD_TOKEN=

# Verbose logging (0 or 1)
VERBOSE=0

# Default model when not specified in request
DEFAULT_MODEL=glm-5

# Trusted proxy CIDRs (for X-Forwarded-For; default: localhost only)
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Gateway SQLite database (accounts, features, request_log)
ACCOUNTS_DB=./data/accounts.sqlite

# Account selection strategy: round-robin | least-used | random
ZAI_STRATEGY=round-robin

# ─── GLM (Z.AI) ─────────────────────────────────────────────────────
# Path to captcha database (required for GLM; generate with cmd/token-collector)
GLM_CAPTCHA_DB=./data/tokens.sqlite

# Enable agent mode (captcha background cache)
AGENT_MODE=0

# ─── MiMo (Xiaomi) ──────────────────────────────────────────────────
# Multi-account configuration (comma-separated, random rotation)
# Get these from: aistudio.xiaomimimo.com → DevTools → Cookies
SERVICE_TOKENS=
USER_IDS=
XIAOMI_CHATBOT_PHS=

# Optional: API key to protect MiMo proxy (in addition to GATEWAY_TOKEN)
# API_KEY=

# ─── CORS ───────────────────────────────────────────────────────────
CORS_ORIGIN=*

# ─── Per-account proxy encryption ───────────────────────────────────
# Encryption key for proxy passwords (32 bytes hex)
# Generate with: openssl rand -hex 32
# PROXY_ENCRYPTION_KEY=

# Separate password for exporting accounts (without revealing GATEWAY_TOKEN)
# EXPORT_PASSWORD=
